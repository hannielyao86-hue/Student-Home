<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="600.0" prefWidth="950.0" spacing="20.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ReservationEtudiantController">

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox HBox.hgrow="ALWAYS" spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
            <Label text="Liste des logements disponibles" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
            <TableView fx:id="tableChambres" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colChambre" text="Chambre" prefWidth="100"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                    <TableColumn fx:id="colCapacite" text="Capacité" prefWidth="100"/>
                    <TableColumn fx:id="colLoyer" text="Loyer (€)" prefWidth="120"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

        <VBox prefWidth="300.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
            <Label text="Fiche d'Information" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            <Separator />

            <VBox spacing="10.0">
                <Label fx:id="infoCapacite" text="Capacité : -" />
                <Label fx:id="infoLoyer" text="Loyer : - €/mois" />
                <Label fx:id="infoStatut" text="Statut : -" style="-fx-font-weight: bold; -fx-text-fill: #059669;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button text="Réserver" onAction="#handleReservation" maxWidth="Infinity"
                    style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-cursor: hand; -fx-background-radius: 8;"/>
        </VBox>
    </HBox>
</VBox>