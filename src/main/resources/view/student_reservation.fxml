<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.StudentReservationController" spacing="18.0" style="-fx-background-color: transparent;" >
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>
    <children>
        <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 6);">
            <children>
                <Label text="🛌 Réservation de logements" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                <Label text="Vous voyez ici uniquement les logements disponibles. Sélectionnez une chambre et cliquez sur Réserver." wrapText="true" style="-fx-text-fill: #475569;" />
            </children>
        </VBox>

        <TableView fx:id="availableRoomsTable" prefHeight="380.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 4);">
            <columns>
                <TableColumn fx:id="numberColumn" text="Chambre" prefWidth="140.0" />
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="140.0" />
                <TableColumn fx:id="capacityColumn" text="Capacité" prefWidth="110.0" />
                <TableColumn fx:id="priceColumn" text="Loyer" prefWidth="120.0" />
                <TableColumn fx:id="statusColumn" text="Statut" prefWidth="120.0" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="reserveButton" mnemonicParsing="false" onAction="#handleReserve" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 18;" text="Réserver" />
            </children>
        </HBox>

        <Label fx:id="infoLabel" text="Chargement des chambres disponibles..." wrapText="true" style="-fx-text-fill: #475569;" />
    </children>
</VBox>
