<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.StudentController"
            style="-fx-background-color: #f5f7fa;">

    <!-- SIDEBAR INCLUE (copié depuis dashboard pour cohérence) -->
    <left>
        <VBox spacing="10"
              style="-fx-background-color: #2c3e50; -fx-padding: 20;">

            <Label text="Smart Student"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Residence"
                   style="-fx-text-fill: #27ae60; -fx-font-size: 14px;"/>

            <Separator style="-fx-background-color: #7f8c8d;"/>

            <Label fx:id="nomUserLabel"
                   style="-fx-text-fill: white; -fx-font-size: 13px;"/>

            <Label fx:id="roleLabel"
                   style="-fx-text-fill: #27ae60; -fx-font-size: 11px;"/>

            <Separator style="-fx-background-color: #7f8c8d;"/>

            <Button text="🏠  Dashboard"
                    prefWidth="180"
                    onAction="#handleDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="👤  Étudiants"
                    prefWidth="180"
                    onAction="#handleEtudiants"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>

            <Button text="🛏  Logements"
                    prefWidth="180"
                    onAction="#handleLogements"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="💰  Paiements"
                    prefWidth="180"
                    onAction="#handlePaiements"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="🔧  Incidents"
                    prefWidth="180"
                    onAction="#handleIncidents"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Déconnexion"
                    fx:id="logoutButton"
                    onAction="#handleLogout"
                    prefWidth="180"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>

        </VBox>
    </left>

    <!-- ================= CENTER ================= -->
    <center>

        <VBox spacing="15" style="-fx-padding: 20;">

            <!-- FORM -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15;">

                <Label text="Gestion Étudiants" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <TextField fx:id="idField" promptText="ID (auto ou pour update/delete)"/>
                <TextField fx:id="numeroField" promptText="Numéro étudiant"/>
                <TextField fx:id="ecoleField" promptText="École"/>
                <TextField fx:id="telephoneField" promptText="Téléphone"/>

                <DatePicker fx:id="dateEntreePicker"/>
                <DatePicker fx:id="dateSortiePicker"/>

                <HBox spacing="10">

                    <Button text="Ajouter" onAction="#handleAddStudent"/>
                    <Button text="Modifier" onAction="#handleUpdateStudent"/>
                    <Button text="Supprimer" onAction="#handleDeleteStudent"/>
                    <Button text="Actualiser" onAction="#loadStudents"/>

                </HBox>

            </VBox>

            <!-- TABLE -->
            <TableView fx:id="studentTable">

                <columns>

                    <TableColumn fx:id="idColumn" text="ID"/>
                    <TableColumn fx:id="numeroColumn" text="Numéro"/>
                    <TableColumn fx:id="ecoleColumn" text="École"/>
                    <TableColumn fx:id="telephoneColumn" text="Téléphone"/>
                    <TableColumn fx:id="dateEntreeColumn" text="Entrée"/>
                    <TableColumn fx:id="dateSortieColumn" text="Sortie"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>