<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.StudentController">

    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Smart Student" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Button text="🏠  Dashboard" prefWidth="180" onAction="#handleDashboard" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="👤  Étudiants/Réservations" prefWidth="180" onAction="#handleEtudiants" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            <Button text="🛏  Logements" prefWidth="180" onAction="#handleLogements" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪  Déconnexion" onAction="#handleLogout" prefWidth="180" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <Label text="Gestion des demandes de réservation" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Button text="Accepter la sélection" onAction="#handleAccepterReservation"
                        style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 180;" />
                <Button text="Actualiser la liste" onAction="#loadDemandesEnAttente"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-pref-width: 150;" />
                <Button text="Refuser la sélection" onAction="#handleRefuserReservation"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-pref-width: 180;" />
            </HBox>

            <TableView fx:id="reservationTable" prefHeight="500">
                <columns>
                    <TableColumn fx:id="nomColumn" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="150"/>
                    <TableColumn fx:id="chambreColumn" text="Chambre" prefWidth="120"/>
                    <TableColumn fx:id="dateEntreeColumn" text="Date Entrée" prefWidth="150"/>
                    <TableColumn fx:id="dateSortieColumn" text="Date Sortie" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>