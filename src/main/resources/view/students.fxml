<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.StudentController">

    <!-- ═════════════════════════════════════════════ -->
    <!-- TOP -->
    <!-- ═════════════════════════════════════════════ -->

    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              style="-fx-background-color:#2c3e50; -fx-padding:15;">

            <Label text="Gestion des Étudiants"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;" />

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Dashboard"
                    onAction="#handleDashboard"
                    style="-fx-background-color:#3498db; -fx-text-fill:white; -fx-font-weight:bold;" />

            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white; -fx-font-weight:bold;" />

        </HBox>
    </top>

    <!-- ═════════════════════════════════════════════ -->
    <!-- CENTER -->
    <!-- ═════════════════════════════════════════════ -->

    <center>

        <VBox spacing="20">

            <!-- padding corrigé -->
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- ================= FORMULAIRE ================= -->

            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="15"/>
                    <ColumnConstraints percentWidth="35"/>
                    <ColumnConstraints percentWidth="15"/>
                    <ColumnConstraints percentWidth="35"/>
                </columnConstraints>

                <!-- ID -->
                <Label text="ID :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="idField"
                           editable="false"
                           promptText="ID automatique"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <!-- NOM -->
                <Label text="Nom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="nomField"
                           promptText="Nom étudiant"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <!-- PRENOM -->
                <Label text="Prénom :" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="prenomField"
                           promptText="Prénom étudiant"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="3"/>

                <!-- EMAIL -->
                <Label text="Email :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField"
                           promptText="Email étudiant"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <!-- ECOLE -->
                <Label text="École :" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <TextField fx:id="ecoleField"
                           promptText="Nom école"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="3"/>

                <!-- TELEPHONE -->
                <Label text="Téléphone :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="telephoneField"
                           promptText="Téléphone"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>

                <!-- DATE ENTREE -->
                <Label text="Date entrée :" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                <DatePicker fx:id="dateEntreePicker"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="3"/>

                <!-- DATE SORTIE -->
                <Label text="Date sortie :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dateSortiePicker"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="1"/>

            </GridPane>

            <!-- ================= BOUTONS ================= -->

            <HBox spacing="15" alignment="CENTER">

                <Button text="Ajouter"
                        onAction="#handleAddStudent"
                        style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-font-weight:bold; -fx-pref-width:120;" />

                <Button text="Modifier"
                        onAction="#handleUpdateStudent"
                        style="-fx-background-color:#f39c12; -fx-text-fill:white; -fx-font-weight:bold; -fx-pref-width:120;" />

                <Button text="Supprimer"
                        onAction="#handleDeleteStudent"
                        style="-fx-background-color:#c0392b; -fx-text-fill:white; -fx-font-weight:bold; -fx-pref-width:120;" />

                <Button text="Actualiser"
                        onAction="#loadStudents"
                        style="-fx-background-color:#2980b9; -fx-text-fill:white; -fx-font-weight:bold; -fx-pref-width:120;" />

            </HBox>

            <!-- ================= TABLE ================= -->

            <TableView fx:id="studentTable"
                       prefHeight="500">

                <columns>

                    <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="nomColumn" text="Nom" prefWidth="140"/>
                    <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="140"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
                    <TableColumn fx:id="ecoleColumn" text="École" prefWidth="150"/>
                    <TableColumn fx:id="telephoneColumn" text="Téléphone" prefWidth="140"/>
                    <TableColumn fx:id="dateEntreeColumn" text="Date Entrée" prefWidth="120"/>
                    <TableColumn fx:id="dateSortieColumn" text="Date Sortie" prefWidth="120"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>