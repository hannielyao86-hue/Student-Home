<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>



<BorderPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controller.IncidentController"
           style="-fx-background-color: #d9d9d9;"
           prefWidth="900" prefHeight="780">
    <left>
        <VBox spacing="10"
              style="-fx-background-color: #2c3e50; -fx-padding: 20;">

            <Label text="Smart Student"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Residence"
                   style="-fx-text-fill: #27ae60; -fx-font-size: 14px;"/>

            <Separator style="-fx-background-color: #7f8c8d;"/>

            <Label fx:id="nomUserLabel"
                   style="-fx-text-fill: white; -fx-font-size: 13px;"/>

            <Label fx:id="roleLabel"
                   style="-fx-text-fill: #27ae60; -fx-font-size: 11px;"/>

            <Separator style="-fx-background-color: #7f8c8d;"/>

            <Button text="🏠  Dashboard"
                    prefWidth="180"
                    onAction="#handleDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="👤  Étudiants"
                    prefWidth="180"
                    onAction="#handleEtudiants"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="🛏  Logements"
                    prefWidth="180"
                    onAction="#handleLogements"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="💰  Paiements"
                    prefWidth="180"
                    onAction="#handlePaiements"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <!-- Incidents = page active, fond vert -->
            <Button text="🔧  Incidents"
                    prefWidth="180"
                    onAction="#handleIncidents"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Déconnexion"
                    onAction="#handleLogout"
                    prefWidth="180"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>

        </VBox>

    </left>

    <center>
    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 30;">

        <!-- FORMULAIRE -->
        <VBox spacing="10"
              style="-fx-background-color: white; -fx-padding: 30;"
              prefWidth="400">

            <Label text="Signaler un incident"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>

            <!-- Type d'incident -->
            <Label text="Type d'incident" alignment="CENTER_LEFT"/>
            <ComboBox fx:id="typeIncidentCombo" maxWidth="340"
                      promptText="Choisir un type"/>

            <!-- Date -->
            <Label text="Date de l'incident" alignment="CENTER_LEFT"/>
            <DatePicker fx:id="datePicker" maxWidth="340"/>

            <!-- Niveau de priorité -->
            <Label text="Niveau de priorité" alignment="CENTER_LEFT"/>
            <ComboBox fx:id="urgenceCombo" maxWidth="340"
                      promptText="Choisir un niveau"/>

            <!-- Description -->
            <Label text="Description de l'incident" alignment="CENTER_LEFT"/>
            <TextArea fx:id="descriptionField"
                      maxWidth="340" prefHeight="100"
                      wrapText="true"
                      style="-fx-background-color: #d9d9d9; -fx-border-color: transparent;"/>

            <!-- Message -->
            <Label fx:id="messageLabel" textFill="red"/>

            <!-- Bouton -->
            <Button text="Signaler l'incident"
                    onAction="#signalerIncident"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-cursor: hand; -fx-translate-y: 10;"/>
        </VBox>

        <!-- LISTE DES INCIDENTS -->
        <VBox spacing="10"
              style="-fx-background-color: white; -fx-padding: 30;"
              HBox.hgrow="ALWAYS">

            <Label text="Incidents signalés"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>

            <ScrollPane fitToWidth="true" prefHeight="650"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;">
                <VBox fx:id="listeIncidents" spacing="10"/>
            </ScrollPane>

        </VBox>

    </HBox>
    </center>

</BorderPane>
