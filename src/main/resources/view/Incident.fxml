<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.IncidentController"
            style="-fx-background-color: #d9d9d9;"
            prefWidth="900" prefHeight="780">
    <left>
        <VBox spacing="10"
              style="-fx-background-color: #2c3e50; -fx-padding: 20;">

            <Label text="Smart Student"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Residence"
                   style="-fx-text-fill: #27ae60; -fx-font-size: 14px;"/>

            <Separator style="-fx-background-color: #7f8c8d;"/>

            <Label fx:id="nomUserLabel" style="-fx-text-fill: white; -fx-font-size: 13px;"/>
            <Label fx:id="roleLabel" style="-fx-text-fill: #27ae60; -fx-font-size: 11px;"/>

            <Separator style="-fx-background-color: #7f8c8d;"/>

            <Button text="🏠  Dashboard" prefWidth="180" onAction="#handleDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="👤  Étudiants" prefWidth="180" onAction="#handleEtudiants"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="🛏  Logements" prefWidth="180" onAction="#handleLogements"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="💰  Paiements" prefWidth="180" onAction="#handlePaiements"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="🔧  Incidents" prefWidth="180" onAction="#handleIncidents"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Déconnexion" onAction="#handleLogout" prefWidth="180"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" style="-fx-padding: 30;" HBox.hgrow="ALWAYS">
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">

                <Label text="Incidents signalés par les résidents"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="listeIncidents" spacing="12"/>
                </ScrollPane>

            </VBox>
        </VBox>
    </center>
</BorderPane>