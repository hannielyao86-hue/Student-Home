<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    dashboard.fxml
    Interface principale après connexion.
    Structure : BorderPane avec sidebar gauche + contenu centre
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.DashboardController"
            style="-fx-background-color: #ecf0f1;">

    <!--SIDEBAR GAUCHE  -->
    <left>
        <VBox spacing="10"
              style="-fx-background-color: #2c3e50; -fx-padding: 20;">

            <!-- Nom de l'application -->
            <Label text="Smart Student"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Residence"
                   style="-fx-text-fill: #27ae60; -fx-font-size: 14px;"/>

            <Separator style="-fx-background-color: #7f8c8d;"/>

            <!-- Nom de l'utilisateur connecté (rempli par le controller) -->
            <Label fx:id="nomUserLabel"
                   style="-fx-text-fill: white; -fx-font-size: 13px;"/>

            <!-- Rôle de l'utilisateur connecté -->
            <Label fx:id="roleLabel"
                   style="-fx-text-fill: #27ae60; -fx-font-size: 11px;"/>

            <Separator style="-fx-background-color: #7f8c8d;"/>

            <!-- MENU NAVIGATION  -->

            <!-- Bouton actif = fond vert -->
            <Button text="🏠  Dashboard"
                    prefWidth="180"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>

            <Button text="👤  Étudiants"
                    prefWidth="180"
                    onAction="#handleEtudiants"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="🛏  Logements"
                    prefWidth="180"
                    onAction="#handleLogements"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="💰  Paiements"
                    prefWidth="180"
                    onAction="#handlePaiements"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <Button text="🔧  Incidents"
                    prefWidth="180"
                    onAction="#handleIncidents"
                    style="-fx-background-color: transparent; -fx-text-fill: white;"/>

            <!-- Espace vide pour pousser le bouton déconnexion en bas -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bouton déconnexion — rouge en bas de sidebar -->
            <Button text="🚪  Déconnexion"
                    fx:id="logoutButton"
                    onAction="#handleLogout"
                    prefWidth="180"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>

        </VBox>
    </left>

    <!--  CONTENU PRINCIPAL  -->
    <center>
        <VBox spacing="20"
              alignment="TOP_LEFT"
              style="-fx-padding: 30;">

            <!-- Titre de la page -->
            <Label text="Tableau de bord"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

            <!--  CARTES STATISTIQUES  -->
            <HBox spacing="20">

                <!-- Carte : nombre d'étudiants -->
                <Button onAction="#handleEtudiants"
                        style="-fx-background-color: #3498db; -fx-padding: 0; -fx-background-radius: 10; -fx-text-fill: white;"
                        prefWidth="200" prefHeight="100">
                    <graphic>
                        <VBox spacing="10" style="-fx-padding: 20;" alignment="TOP_LEFT">
                            <Label text="Étudiants"
                                   style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                            <Label fx:id="nbEtudiantsLabel"
                                   text="0"
                                   style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        </VBox>
                    </graphic>
                </Button>

                <!-- Carte : logements disponibles -->
                <Button onAction="#handleLogements"
                        style="-fx-background-color: #27ae60; -fx-padding: 0; -fx-background-radius: 10; -fx-text-fill: white;"
                        prefWidth="200" prefHeight="100">
                    <graphic>
                        <VBox spacing="10" style="-fx-padding: 20;" alignment="TOP_LEFT">
                            <Label text="Logements disponibles"
                                   style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                            <Label fx:id="nbLogementsLabel"
                                   text="0"
                                   style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        </VBox>
                    </graphic>
                </Button>

                <!-- Carte : incidents en cours -->
                <Button onAction="#handleIncidents"
                        style="-fx-background-color: #e74c3c; -fx-padding: 0; -fx-background-radius: 10; -fx-text-fill: white;"
                        prefWidth="200" prefHeight="100">
                    <graphic>
                        <VBox spacing="10" style="-fx-padding: 20;" alignment="TOP_LEFT">
                            <Label text="Incidents en cours"
                                   style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                            <Label fx:id="nbIncidentsLabel"
                                   text="0"
                                   style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                        </VBox>
                    </graphic>
                </Button>

            </HBox>

        </VBox>
    </center>

</BorderPane>