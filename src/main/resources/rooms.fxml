<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<!-- Interface principale pour la gestion des chambres d'hôtel -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.RoomsController">

    <!-- ============= ZONE SUPÉRIEURE - EN-TÊTE ET RECHERCHE ============= -->
    <top>
        <VBox styleClass="header-pane">
            <!-- Titre de l'application -->
            <HBox>
                <Label text="Rooms" styleClass="title-label"/>
            </HBox>

            <!-- Champ de recherche -->
            <HBox styleClass="search-pane">
                <Label text="Rechercher:" styleClass="search-label"/>
                <TextField fx:id="searchField"
                           promptText="Numéro de chambre ou nom client..."
                           styleClass="search-field"
                           HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <!-- ============= ZONE CENTRALE - LISTE DES CHAMBRES ============= -->
    <center>
        <ScrollPane styleClass="main-scrollpane">
            <!-- Conteneur en grille pour les cartes des chambres -->
            <FlowPane fx:id="roomsContainer"
                      styleClass="room-container"
                      prefWrapLength="900"
                      orientation="HORIZONTAL"
                      vgap="15"
                      hgap="15"/>
        </ScrollPane>
    </center>

    <!-- ============= ZONE DROITE - DÉTAILS DE LA CHAMBRE ============= -->
    <right>
        <VBox styleClass="details-pane" prefWidth="350">

            <!-- Section image -->
            <VBox styleClass="preview-section">
                <Label text="Aperçu" styleClass="preview-title"/>
                <!-- Zone d'affichage d'image (placeholders disponibles) -->
                <StackPane styleClass="preview-frame" prefHeight="180">
                    <Label text="[Image de la chambre]" styleClass="preview-text"/>
                </StackPane>
            </VBox>

            <!-- Scrollable pour les détails (en cas de long contenu) -->
            <ScrollPane styleClass="details-scrollpane">
                <VBox styleClass="details-content">

                    <!-- Section informations générales -->
                    <VBox styleClass="detail-group">
                        <Label text="Informations générales" styleClass="section-title"/>

                        <!-- Numéro de chambre -->
                        <HBox styleClass="search-pane">
                            <Label text="Numéro:" styleClass="detail-label"/>
                            <Label fx:id="roomNumberLabel" styleClass="detail-value"/>
                        </HBox>

                        <!-- État de la chambre -->
                        <HBox styleClass="search-pane">
                            <Label text="État:" styleClass="detail-label"/>
                            <Label fx:id="roomStatusLabel" styleClass="detail-value"/>
                        </HBox>

                        <!-- Type de chambre -->
                        <HBox styleClass="search-pane">
                            <Label text="Type:" styleClass="detail-label"/>
                            <Label fx:id="roomTypeLabel" styleClass="detail-value"/>
                        </HBox>

                        <!-- Nombre d'occupants -->
                        <HBox styleClass="search-pane">
                            <Label text="Occupants:" styleClass="detail-label"/>
                            <Label fx:id="occupantsLabel" styleClass="detail-value"/>
                        </HBox>
                    </VBox>

                    <!-- Séparation visuelle -->
                    <Separator/>

                    <!-- Section informations client -->
                    <VBox styleClass="detail-group">
                        <Label text="Informations client" styleClass="section-title"/>

                        <!-- Nom du client -->
                        <HBox styleClass="search-pane">
                            <Label text="Nom" styleClass="detail-label"/>
                            <Label fx:id="clientNameLabel" styleClass="detail-value-wrap"/>
                        </HBox>

                        <!-- Contact -->
                        <HBox styleClass="search-pane">
                            <Label text="Contact" styleClass="detail-label"/>
                            <Label fx:id="contactLabel" styleClass="detail-value"/>
                        </HBox>
                    </VBox>

                    <!-- Séparation visuelle -->
                    <Separator/>

                    <!-- Section dates et tarif -->
                    <VBox styleClass="detail-group">
                        <Label text="Contrat de location" styleClass="section-title"/>

                        <!-- Date de début -->
                        <HBox styleClass="search-pane">
                            <Label text="Du" styleClass="detail-label"/>
                            <Label fx:id="startDateLabel" styleClass="detail-value"/>
                        </HBox>

                        <!-- Date de fin -->
                        <HBox styleClass="search-pane">
                            <Label text="Au" styleClass="detail-label"/>
                            <Label fx:id="endDateLabel" styleClass="detail-value"/>
                        </HBox>

                        <!-- Montant du loyer -->
                        <HBox styleClass="search-pane">
                            <Label text="Loyer" styleClass="detail-label"/>
                            <Label fx:id="leaseAmountLabel" styleClass="detail-value"/>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- Séparation visuelle -->
            <Separator/>

            <!-- Section boutons d'action -->
            <VBox styleClass="action-buttons">
                <!-- Bouton Modifier -->
                <Button fx:id="modifyButton"
                        text="Modifier"
                        styleClass="action-button modify-button"
                        prefWidth="Infinity"/>

                <!-- Bouton Générer Contrat -->
                <Button fx:id="generateContractButton"
                        text="Générer Contrat"
                        styleClass="action-button contract-button"
                        prefWidth="Infinity"/>
            </VBox>

        </VBox>
    </right>

</BorderPane>
